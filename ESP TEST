--[[
    ESP Highlight Auto - HoangOggy
    - Tự động bật khi chạy, không menu.
    - Chỉ dùng Highlight viền trắng bao quanh cơ thể.
    - Không có vòng tròn hay chấm nào trên đầu.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local WHITE = Color3.fromRGB(255, 255, 255)
local espHighlights = {}

local function clearHighlight(plr)
    if espHighlights[plr] then
        espHighlights[plr]:Destroy()
        espHighlights[plr] = nil
    end
end

local function createHighlight(plr, char)
    clearHighlight(plr)
    if plr == LocalPlayer then return end
    if not char or not char.Parent or not char:FindFirstChild("Humanoid") then return end

    local hl = Instance.new("Highlight")
    hl.Name = "OggyESP"
    hl.FillColor = WHITE
    hl.OutlineColor = WHITE
    hl.FillTransparency = 0.7
    hl.OutlineTransparency = 0.1
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Enabled = true
    hl.Parent = char
    espHighlights[plr] = hl
end

local function setupPlayer(plr)
    if plr == LocalPlayer then return end
    if plr.Character then
        createHighlight(plr, plr.Character)
    end
    plr.CharacterAdded:Connect(function(char)
        task.wait(0.1)
        createHighlight(plr, char)
    end)
end

Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(function(plr)
    clearHighlight(plr)
end)

for _, plr in ipairs(Players:GetPlayers()) do
    setupPlayer(plr)
end

RunService.RenderStepped:Connect(function()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hl = espHighlights[plr]
            if not hl or not hl.Parent or hl.Parent ~= plr.Character then
                createHighlight(plr, plr.Character)
            else
                hl.Enabled = true
                hl.FillColor = WHITE
                hl.OutlineColor = WHITE
                hl.FillTransparency = 0.7
                hl.OutlineTransparency = 0.1
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            end
        end
    end
end)
